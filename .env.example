# Ordinary defaults for the public ghstats pilot. VibeNest reconciles this template.
HOST=0.0.0.0
PORT=8080
DB_PATH=/app/data/ghstats.db
# Exact public repository only; change this when collecting your own repository.
# A filter does not restrict the token's permissions or remove old database rows.
GHS_FILTER=NikitaBabenko/ghstats
GHS_INCLUDE_PRIVATE=false
GHS_CRON_SCHEDULE="0 59 * * * *"

# External credential: supply your own fine-grained token for the selected repo.
# VibeNest must not invent this value. Never commit a real token.
GITHUB_TOKEN=

# Internal JSON API secret: VibeNest recognizes *_AUTH_SECRET and generates it
# when absent, then stores it for reuse. Local Compose users must set it themselves.
# Compose maps this to ghstats' GHS_API_TOKEN. An existing nonempty GHS_API_TOKEN
# override takes precedence, so this recipe does not rotate an existing API key.
GHS_AUTH_SECRET=
